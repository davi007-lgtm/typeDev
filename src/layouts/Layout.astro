---
interface Props {
	title: string;
}

const { title } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="TypeDev - Code typing practice for developers"
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | TypeDev</title>
		<!-- Google Fonts: JetBrains Mono for editor, Geist for UI -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Geist:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="bg-[#0b0e14] text-gray-200 font-sans selection:bg-yellow-400 selection:text-black antialiased"
	>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--accent: #eab308;
		--accent-dim: #ca8a04;
		--bg-dark: #0b0e14;
		--bg-lighter: #161b22;
		--font-ui: "Geist", sans-serif;
		--font-code: "JetBrains Mono", monospace;
	}

	body {
		font-family: var(--font-ui);
	}

	.code-font {
		font-family: var(--font-code);
	}

	* {
		box-sizing: border-box;
		scrollbar-width: thin;
		scrollbar-color: #30363d transparent;
	}

	::-webkit-scrollbar {
		width: 6px;
	}
	::-webkit-scrollbar-thumb {
		background: #30363d;
		border-radius: 10px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}

	/* Smooth hover transitions globally */
	button {
		transition-property:
			color, background-color, border-color, transform, box-shadow;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
	}

	/* btn-primary utility */
	.btn-primary {
		background: linear-gradient(135deg, #eab308, #ca8a04);
		color: #000;
		font-weight: 700;
		border-radius: 0.75rem;
		box-shadow:
			0 0 0 1px rgba(234, 179, 8, 0.3),
			0 20px 40px -10px rgba(234, 179, 8, 0.4);
	}
	.btn-primary:hover {
		box-shadow:
			0 0 0 1px rgba(234, 179, 8, 0.5),
			0 20px 50px -8px rgba(234, 179, 8, 0.5);
		transform: scale(1.03);
	}
</style>
